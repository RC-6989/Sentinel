# Sentinel environment variables

# Copy this file to `apps/web/.env.local` for local Next.js development.
# Never commit real secrets.

## Application

# local | staging | production
SENTINEL_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0

## Waitlist (required on Vercel)

# Use a form endpoint that accepts JSON { email, source, submittedAt }.
# A Discord webhook needs a payload adapter; its URL alone is not compatible.
# Locally, if unset, emails are stored in SQLite under apps/web/.data/
# WAITLIST_WEBHOOK_URL=https://formspree.io/f/your_form_id

## Local database

# Optional override (default: apps/web/.data/sentinel.sqlite)
# SENTINEL_DATA_DIR=

## Auth (dashboard — gated while waitlist mode is on)

# Production defaults to waitlist mode; local development enables the dashboard.
# Set false only on a server with persistent SQLite storage to enable production auth.
# SENTINEL_WAITLIST_MODE=false
# Also set an absolute path on a durable volume and explicitly confirm it is persistent.
# Neither variable alone opens the dashboard.
# SENTINEL_DATA_DIR=/path/to/durable/sentinel-data
# SENTINEL_PERSISTENT_STORAGE_CONFIRMED=true

# Required for production dashboard authentication (min 32 characters). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=local-dev-only-replace-with-long-random-string-32chars-min
AUTH_URL=http://localhost:3000

## Database (Cloudflare D1 — hosted integration pending)

# These are unused placeholders, not required setup keys.
# The staging DB is configured through worker/wrangler.toml's DB binding.
# Never put a Cloudflare API token in browser code.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=

## Optional BYOK AI detectors (disabled by default — leave unset)

# SENTINEL_AI_DETECTOR_ENABLED=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

## Cost protection / kill switches

# SENTINEL_GLOBAL_KILL_SWITCH=false
# Exact target origins the local gateway may call. Empty means no tool execution.
# SENTINEL_ALLOWED_TOOL_ORIGINS=https://api.example.com
# For local testing only, explicitly permit HTTP to localhost/127.0.0.1/[::1].
# SENTINEL_ALLOW_INSECURE_LOOPBACK_TOOLS=false
# SENTINEL_MAX_TOOL_CALLS_PER_ORG_MONTH=10000

## Demo / attack simulator

# SENTINEL_DEMO_ENABLED=true
# SENTINEL_ATTACK_SIMULATOR_ENABLED=true
